<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(BlobatarMauiTargetFrameworks)' == ''">net8.0;net9.0;net10.0;net8.0-windows10.0.19041.0;net9.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(BlobatarMauiTargetFrameworks)' != ''">$(BlobatarMauiTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <WindowsAppSDKGeneratePriEnabled>false</WindowsAppSDKGeneratePriEnabled>
    <Description>MAUI BlobatarControl with vector rendering, expressions, animation, and pointer/touch gaze.</Description>
    <PackageTags>avatar;blobatar;maui;graphics;vector</PackageTags>
  </PropertyGroup>
  <Import Project="../../MauiVersions.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(BlobatarMauiVersion)" />
    <ProjectReference Include="../Blobatar.Net.Core/Blobatar.Net.Core.csproj" />
  </ItemGroup>
</Project>
